#pragma kernel CSMain
#pragma kernel CSSensor

#define SAMPLES_PER_FRAME 64

// --- Arrow rotation settings (edit here) ---
#define ARROW_ROTATION_AXIS  float3(0.0f, 1.0f, 0.0f)   
#define ARROW_ROTATION_SPEED 1.0f                       
#define ARROW_BASE_DIRECTION float3(1.0f, 1.0f, 1.0f)   

// --- Plane settings (driven from the Unity Inspector) ---
float3 _SensorCenter;        
float2 _SensorHalfSize;      
float2 _SensorGridCells;     
float  _SensorGridEnabled;   
float  _SensorLineWidth;     
float  _SensorBorderWidth;   
float4 _SensorColor;         
float4 _SensorGridColor;     
float4 _SensorBorderColor;   

// Rough surface patch
float3 _PatchCenter;         
float  _PatchHalfSize;       
float  _PatchAmplitude;      
float  _PatchNoiseFrequency; 
float4 _PatchLowColor;       
float4 _PatchHighColor;      

// Mouse optics
float  _LensY;               
float  _LensRadius;          
float  _SensorImageDist;     
float  _ObjectDist;          
int    _SensorSamples;       
float  _SensorBlend;         
float  _ShowSensorImage;     
float  _SensorExposure;      
float  _ShowOptics;          

struct Ray {
    float3 origin;
    float3 direction;
    float wavelength; 
};

struct HitRecord {
    bool didIntersect;
    float t;
    float3 position;
    float3 normal;
    int materialID;    
};

// --- Buffers & Textures ---
RWTexture2D<float4> Result;              
RWTexture2D<float4> AccumulationBuffer;  
RWTexture2D<float4> SensorImage;         

// --- Uniforms & Transform Matrices ---
float4x4 _CameraToWorld;
float4x4 _CameraInverseProjection;
float _Time;
int _SampleIndex;

float4 _LightPosition;
float _LightIntensity; 
float _IntensityClamp; 

// --- PRNG Subsystem ---
uint GenerateSeed(uint2 id, uint width, float time) {
    uint timeSeed = asuint(time);
    uint state = id.y * width + id.x;
    state ^= timeSeed;
    state = state * 277803737u + 289133645u;
    return state;
}

float NextRandom(inout uint state) {
    state = state * 747796405u + 289133645u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (float)((word >> 22u) ^ word) / 4294967295.0f;
}

float3 RandomInUnitSphere(inout uint state) {
    while (true) {
        float3 p = float3(NextRandom(state)*2.0f-1.0f, NextRandom(state)*2.0f-1.0f, NextRandom(state)*2.0f-1.0f);
        if (dot(p, p) < 1.0f) return p;
    }
    return float3(0,0,0);
}

float3 RotateAroundAxis(float3 v, float3 axis, float angle) {
    axis = normalize(axis);
    float s = sin(angle);
    float c = cos(angle);
    return v * c + cross(axis, v) * s + axis * dot(axis, v) * (1.0f - c);
}

float Hash21(float2 p) {
    float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031f);
    p3 += dot(p3, p3.yzx + 33.33f);
    return frac((p3.x + p3.y) * p3.z);
}

float ValueNoise(float2 p) {
    float2 i = floor(p);
    float2 f = frac(p);
    f = f * f * (3.0f - 2.0f * f); 
    float a = Hash21(i);
    float b = Hash21(i + float2(1, 0));
    float c = Hash21(i + float2(0, 1));
    float d = Hash21(i + float2(1, 1));
    return lerp(lerp(a, b, f.x), lerp(c, d, f.x), f.y);
}

float SurfaceHeight(float2 xz) {
    float h = 0.0f;
    float amp = 0.5f;
    float freq = _PatchNoiseFrequency;
    [unroll]
    for (int o = 0; o < 3; o++) {      
        h += ValueNoise(xz * freq) * amp;
        freq *= 2.0f;
        amp *= 0.5f;
    }
    return h * _PatchAmplitude * 2.0f;
}

float EvaluateEmission(int matID, float wavelength) {
    if (matID == 4) return _LightIntensity; 
    return 0.0f;
}

float EvaluateSkyEmission(float wavelength, float3 rayDir) {
    return 0.0f;
}

float3 WavelengthToXYZ(float wave) {
    float x1 = 1.065f * exp(-0.5f * ((wave - 595.8f) / 33.4f) * ((wave - 595.8f) / 33.4f));
    float x2 = 0.366f * exp(-0.5f * ((wave - 446.8f) / 18.2f) * ((wave - 446.8f) / 18.2f));
    return float3(x1 + x2, 1.014f * exp(-0.5f * ((wave - 556.4f) / 40.4f) * ((wave - 556.4f) / 40.4f)), 1.839f * exp(-0.5f * ((wave - 446.8f) / 22.7f) * ((wave - 446.8f) / 22.7f)));
}

float3 XYZToRGB(float3 xyz) {
    return float3(2.975424f * xyz.x - 1.402930f * xyz.y - 0.453346f * xyz.z, -0.923164f * xyz.x + 1.832263f * xyz.y + 0.035174f * xyz.z, 0.053158f * xyz.x - 1.936616f * xyz.y + 1.050730f * xyz.z);
}

// --- Intersections ---
void IntersectSphere(Ray ray, inout HitRecord bestHit, float3 center, float radius, int matID) {
    float3 oc = ray.origin - center;
    float b = dot(oc, ray.direction);
    float c = dot(oc, oc) - radius * radius;
    float discriminant = b * b - c;
    if (discriminant < 0.0f) return;
    float t = -b - sqrt(discriminant);
    if (t <= 0.001f) t = -b + sqrt(discriminant);
    if (t > 0.001f && t < bestHit.t) {
        bestHit.didIntersect = true;
        bestHit.t = t;
        bestHit.position = ray.origin + t * ray.direction;
        bestHit.normal = normalize(bestHit.position - center);
        bestHit.materialID = matID;
    }
}

void IntersectPlane(Ray ray, inout HitRecord bestHit, float3 planeOrigin, float3 planeNormal, int matID) {
    float denom = dot(planeNormal, ray.direction);
    if (abs(denom) > 1e-6f) {
        float t = dot(planeOrigin - ray.origin, planeNormal) / denom;
        if (t > 0.001f && t < bestHit.t) {
            bestHit.didIntersect = true;
            bestHit.t = t;
            bestHit.position = ray.origin + t * ray.direction;
            bestHit.normal = planeNormal; 
            bestHit.materialID = matID;
        }
    }
}

void IntersectSensorPlane(Ray ray, inout HitRecord bestHit, float3 center, float halfWidth, float halfDepth, int matID) {
    float3 normal = float3(0.0f, -1.0f, 0.0f);
    float denom = dot(normal, ray.direction);
    if (abs(denom) > 1e-6f) {
        float t = dot(center - ray.origin, normal) / denom;
        if (t > 0.001f && t < bestHit.t) {
            float3 hitPos = ray.origin + t * ray.direction;
            float2 localPos = hitPos.xz - center.xz;
            if (abs(localPos.x) <= halfWidth && abs(localPos.y) <= halfDepth) {
                bestHit.didIntersect = true;
                bestHit.t = t;
                bestHit.position = hitPos;
                bestHit.normal = (denom < 0.0f) ? normal : -normal;
                bestHit.materialID = matID;
            }
        }
    }
}

void IntersectLensDisk(Ray ray, inout HitRecord bestHit, float3 center, float radius, int matID) {
    if (abs(ray.direction.y) > 1e-6f) {
        float t = (center.y - ray.origin.y) / ray.direction.y;
        if (t > 0.001f && t < bestHit.t) {
            float3 hitPos = ray.origin + t * ray.direction;
            float2 d = hitPos.xz - center.xz;
            if (dot(d, d) <= radius * radius) {
                bestHit.didIntersect = true;
                bestHit.t = t;
                bestHit.position = hitPos;
                bestHit.normal = (ray.direction.y < 0.0f) ? float3(0, 1, 0) : float3(0, -1, 0);
                bestHit.materialID = matID;
            }
        }
    }
}

void IntersectBillboardAxis(Ray ray, inout HitRecord bestHit, float3 axisDir, float width, int matID) {
    float3 camForward = _CameraToWorld._m02_m12_m22;
    float3 s = cross(axisDir, camForward);
    if (dot(s, s) < 1e-4f) {
        s = cross(axisDir, _CameraToWorld._m01_m11_m21); 
    }
    s = normalize(s);
    float3 n = normalize(cross(axisDir, s));
    
    float denom = dot(n, ray.direction);
    if (abs(denom) > 1e-6f) {
        float t = -dot(n, ray.origin) / denom;
        if (t > 0.001f && t < bestHit.t) {
            float3 hitPos = ray.origin + t * ray.direction;
            float sideCoord = dot(hitPos, s);
            if (abs(sideCoord) <= width * 0.5f) {
                bestHit.didIntersect = true;
                bestHit.t = t;
                bestHit.position = hitPos;
                bestHit.normal = (denom < 0.0f) ? n : -n;
                bestHit.materialID = matID;
            }
        }
    }
}

void IntersectCylinder(Ray ray, inout HitRecord bestHit, float3 origin, float3 dir, float length, float radius, int matID) {
    float3 u = normalize(dir);
    float3 o = ray.origin - origin;
    float3 d = ray.direction;
    
    float3 d_proj = d - dot(d, u) * u;
    float3 o_proj = o - dot(o, u) * u;
    
    float a = dot(d_proj, d_proj);
    float b = 2.0f * dot(o_proj, d_proj);
    float c = dot(o_proj, o_proj) - radius * radius;
    float disc = b * b - 4.0f * a * c;

    if (disc >= 0.0f && a > 1e-6f) {
        float sqrtDisc = sqrt(disc);
        float t1 = (-b - sqrtDisc) / (2.0f * a);
        float t2 = (-b + sqrtDisc) / (2.0f * a);
        
        float tCyl = (t1 > 0.001f) ? t1 : t2;
        if (tCyl > 0.001f && tCyl < bestHit.t) {
            float3 hitPos = ray.origin + tCyl * ray.direction;
            float h = dot(hitPos - origin, u);
            if (h >= 0.0f && h <= length) {
                bestHit.didIntersect = true;
                bestHit.t = tCyl;
                bestHit.position = hitPos;
                bestHit.normal = normalize((hitPos - origin) - u * h);
                bestHit.materialID = matID;
            }
        }
    }
}

void IntersectCone(Ray ray, inout HitRecord bestHit, float3 tip, float3 dir, float height, float radius, int matID) {
    float3 u = normalize(dir);
    float3 vAxis = -u; 
    float3 CO = ray.origin - tip;
    
    float h2 = height * height;
    float r2 = radius * radius;
    float cos2 = h2 / (h2 + r2);
    
    float dDotV = dot(ray.direction, vAxis);
    float coDotV = dot(CO, vAxis);
    float dDotD = dot(ray.direction, ray.direction);
    float coDotCO = dot(CO, CO);
    
    float a = dDotV * dDotV - dDotD * cos2;
    float b = 2.0f * (dDotV * coDotV - dot(ray.direction, CO) * cos2);
    float c = coDotV * coDotV - coDotCO * cos2;
    
    float disc = b * b - 4.0f * a * c;
    if (disc >= 0.0f && abs(a) > 1e-6f) {
        float sqrtDisc = sqrt(disc);
        float t1 = (-b - sqrtDisc) / (2.0f * a);
        float t2 = (-b + sqrtDisc) / (2.0f * a);
        
        float candidateT = 1e20f;
        float candidateH = 0.0f;
        bool valid1 = false, valid2 = false;
        float h1 = 0.0f, h2_val = 0.0f;
        
        if (t1 > 0.001f) {
            float3 hp1 = ray.origin + t1 * ray.direction;
            h1 = dot(hp1 - tip, vAxis);
            if (h1 >= 0.0f && h1 <= height) valid1 = true;
        }
        if (t2 > 0.001f) {
            float3 hp2 = ray.origin + t2 * ray.direction;
            h2_val = dot(hp2 - tip, vAxis);
            if (h2_val >= 0.0f && h2_val <= height) valid2 = true;
        }
        
        if (valid1 && valid2) {
            candidateT = min(t1, t2);
            candidateH = (candidateT == t1) ? h1 : h2_val;
        } else if (valid1) {
            candidateT = t1;
            candidateH = h1;
        } else if (valid2) {
            candidateT = t2;
            candidateH = h2_val;
        }
        
        if (candidateT > 0.001f && candidateT < bestHit.t) {
            float3 hitPos = ray.origin + candidateT * ray.direction;
            bestHit.didIntersect = true;
            bestHit.t = candidateT;
            bestHit.position = hitPos;
            
            float3 radial = (hitPos - tip) - candidateH * vAxis;
            float3 normal = normalize(radial * height - vAxis * radius);
            if (dot(normal, ray.direction) > 0.0f) normal = -normal;
            bestHit.normal = normal;
            bestHit.materialID = matID;
        }
    }
}

void IntersectRoughPatch(Ray ray, inout HitRecord bestHit, float3 center, float halfSize, int matID) {
    float minY = center.y;
    float maxY = center.y + _PatchAmplitude * 2.0f;

    float3 bmin = float3(center.x - halfSize, minY, center.z - halfSize);
    float3 bmax = float3(center.x + halfSize, maxY, center.z + halfSize);
    float3 invD = 1.0f / ray.direction;
    float3 t0 = (bmin - ray.origin) * invD;
    float3 t1 = (bmax - ray.origin) * invD;
    float3 tsm = min(t0, t1);
    float3 tbg = max(t0, t1);
    float tEnter = max(max(tsm.x, tsm.y), max(tsm.z, 0.001f));
    float tExit  = min(min(tbg.x, tbg.y), tbg.z);
    if (tEnter >= tExit || tEnter > bestHit.t) return;

    const int STEPS = 64;
    float dt = (tExit - tEnter) / (float)STEPS;
    float tPrev = tEnter;
    float3 pPrev = ray.origin + tPrev * ray.direction;
    float hPrev = pPrev.y - (center.y + SurfaceHeight(pPrev.xz - center.xz));

    [loop]
    for (int s = 1; s <= STEPS; s++) {
        float tCur = tEnter + dt * s;
        float3 pCur = ray.origin + tCur * ray.direction;
        float hCur = pCur.y - (center.y + SurfaceHeight(pCur.xz - center.xz));

        if (hPrev > 0.0f && hCur <= 0.0f) {
            float tLo = tPrev, tHi = tCur;
            [unroll]
            for (int b = 0; b < 5; b++) {
                float tMid = 0.5f * (tLo + tHi);
                float3 pm = ray.origin + tMid * ray.direction;
                float hm = pm.y - (center.y + SurfaceHeight(pm.xz - center.xz));
                if (hm > 0.0f) tLo = tMid; else tHi = tMid;
            }
            float tHit = 0.5f * (tLo + tHi);

            if (tHit < bestHit.t) {
                float3 pos = ray.origin + tHit * ray.direction;
                float2 q = pos.xz - center.xz;
                float e = 0.005f;
                float h0 = SurfaceHeight(q);
                float hx = SurfaceHeight(q + float2(e, 0)) - h0;
                float hz = SurfaceHeight(q + float2(0, e)) - h0;
                bestHit.didIntersect = true;
                bestHit.t = tHit;
                bestHit.position = pos;
                bestHit.normal = normalize(float3(-hx, e, -hz));
                bestHit.materialID = matID;
            }
            return;
        }
        tPrev = tCur;
        hPrev = hCur;
    }
}

// Surface shading with top-down orthogonal projected grid lines (safe compute shader implementation without ddx/ddy)
float3 PatchColor(float3 pos, float3 normal) {
    float3 L = normalize(_LightPosition.xyz - pos);
    float ndl = saturate(dot(normal, L));
    
    float hNorm = saturate((pos.y - _PatchCenter.y) / max(_PatchAmplitude * 2.0f, 1e-4f));
    float3 baseColor = lerp(_PatchLowColor.rgb, _PatchHighColor.rgb, hNorm);

    if (_SensorGridEnabled > 0.5f) {
        float2 cells = max(_SensorGridCells, float2(1.0f, 1.0f));
        float2 gridUV = (pos.xz - _PatchCenter.xz + _PatchHalfSize) / (2.0f * _PatchHalfSize); 
        float2 gridScaled = gridUV * cells;
        float2 cellFrac = frac(gridScaled);
        float2 distToLine = min(cellFrac, 1.0f - cellFrac);
        
        // Use explicit scale-based threshold instead of forbidden screen derivatives (ddx/ddy) in compute kernels
        float2 strokeWidth = float2(_SensorLineWidth, _SensorLineWidth) * 0.5f;
        bool onLine = (distToLine.x < strokeWidth.x || distToLine.y < strokeWidth.y);
        if (onLine) {
            baseColor = _SensorGridColor.rgb;
        }
    }

    return baseColor * (0.15f + 1.5f * ndl);
}

// --- Sensor simulation kernel ---
[numthreads(8, 8, 1)]
void CSSensor(uint3 id : SV_DispatchThreadID) {
    uint w, h;
    SensorImage.GetDimensions(w, h);
    if (id.x >= w || id.y >= h) return;

    uint rng = GenerateSeed(id.xy, w, _Time);
    float3 C = float3(_SensorCenter.x, _LensY, _SensorCenter.z);
    float sum = 0.0f;

    [loop]
    for (int smp = 0; smp < _SensorSamples; smp++) {
        float2 pix = (float2(id.xy) + float2(NextRandom(rng), NextRandom(rng))) / float2(w, h);   
        float3 P = float3(_SensorCenter.x + (pix.x * 2.0f - 1.0f) * _SensorHalfSize.x,
                          _SensorCenter.y,
                          _SensorCenter.z + (pix.y * 2.0f - 1.0f) * _SensorHalfSize.y);

        float r = _LensRadius * sqrt(NextRandom(rng));
        float a = 6.2831853f * NextRandom(rng);
        float3 L = C + float3(r * cos(a), 0.0f, r * sin(a));          

        float3 F = C + (C - P) * (_ObjectDist / _SensorImageDist);    

        Ray ray;
        ray.origin = L;
        ray.direction = normalize(F - L);
        ray.wavelength = 0.0f;

        HitRecord hit;
        hit.didIntersect = false;
        hit.t = 1e20f;
        hit.position = float3(0, 0, 0);
        hit.normal = float3(0, 0, 0);
        hit.materialID = 0;
        IntersectRoughPatch(ray, hit, _PatchCenter, _PatchHalfSize, 9);

        if (hit.didIntersect) {
            float3 c = PatchColor(hit.position, hit.normal);
            sum += dot(c, float3(0.299f, 0.587f, 0.114f));            
        }
    }

    float value = sum / (float)max(_SensorSamples, 1);
    float prev = SensorImage[id.xy].r;
    float blended = lerp(prev, value, saturate(_SensorBlend));
    SensorImage[id.xy] = float4(blended, blended, blended, 1.0f);
}

[numthreads(32, 32, 1)]
void CSMain(uint3 id : SV_DispatchThreadID) {
    uint width, height;
    Result.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;
    
    uint rngState = GenerateSeed(id.xy, width, _Time);
    float2 uvJitterAA = (float2(id.xy) + float2(NextRandom(rngState), NextRandom(rngState))) / float2(width, height);
    
    float4 jitterClip = float4(uvJitterAA.x * 2.0f - 1.0f, uvJitterAA.y * 2.0f - 1.0f, 0.0f, 1.0f);
    float4 jitterView = mul(_CameraInverseProjection, jitterClip); 
    jitterView /= jitterView.w;
    
    Ray jitterRay; 
    jitterRay.origin = _CameraToWorld._m03_m13_m23;
    jitterRay.direction = normalize(mul(_CameraToWorld, float4(jitterView.xyz, 0.0f)).xyz);
    jitterRay.wavelength = 0.0f;

    float3 arrowOrigin = float3(0.0f, 0.0f, 0.0f);
    float3 arrowDir = normalize(RotateAroundAxis(normalize(ARROW_BASE_DIRECTION), ARROW_ROTATION_AXIS, _Time * ARROW_ROTATION_SPEED));
    float arrowTotalLength = 5.0f;
    float arrowHeadLength = 0.8f;
    float arrowShaftLength = arrowTotalLength - arrowHeadLength;
    float3 arrowTipPos = arrowOrigin + arrowDir * arrowTotalLength;

    float3 accumulatedFrameRGB = float3(0.0f, 0.0f, 0.0f);
    float skyPixelsAccumulator = 0.0f;
    int arrowPrimaryHits = 0;

    HitRecord patchHit;
    patchHit.didIntersect = false;
    patchHit.t = 1e20f;
    patchHit.position = float3(0, 0, 0);
    patchHit.normal = float3(0, 0, 0);
    patchHit.materialID = 0;
    IntersectRoughPatch(jitterRay, patchHit, _PatchCenter, _PatchHalfSize, 9); 

    [loop]
    for (int smpl = 0; smpl < SAMPLES_PER_FRAME; smpl++) 
    {
        Ray ray;
        ray.origin = jitterRay.origin;
        ray.direction = jitterRay.direction;
        ray.wavelength = 380.0f + NextRandom(rngState) * 400.0f;
        
        float throughput = 1.0f;
        float finalSpectralRadiance = 0.0f;
        bool sampleHitSkyDirectly = false;
        int maxBounces = 4;

        [loop]
        for (int i = 0; i < maxBounces; i++) 
        {
            HitRecord hit;
            hit.didIntersect = false; 
            hit.t = 1e20f;
            hit.position = float3(0, 0, 0);
            hit.normal = float3(0, 0, 0);
            hit.materialID = 0;

            IntersectPlane(ray, hit, float3(0.0f, -1.5f, 0.0f), float3(0.0f, 1.0f, 0.0f), 2);
            IntersectSphere(ray, hit, _LightPosition.xyz, 0.2f, 4);

            if (i == 0) {
                IntersectBillboardAxis(ray, hit, float3(1.0f, 0.0f, 0.0f), 0.04f, 5); 
                IntersectBillboardAxis(ray, hit, float3(0.0f, 1.0f, 0.0f), 0.04f, 6); 
                IntersectBillboardAxis(ray, hit, float3(0.0f, 0.0f, 1.0f), 0.04f, 7); 

                IntersectCylinder(ray, hit, arrowOrigin, arrowDir, arrowShaftLength, 0.04f, 8);
                IntersectCone(ray, hit, arrowTipPos, arrowDir, arrowHeadLength, 0.15f, 8);

                if (_ShowOptics > 0.5f) {
                    IntersectSensorPlane(ray, hit, _SensorCenter, _SensorHalfSize.x, _SensorHalfSize.y, 10);
                    IntersectLensDisk(ray, hit, float3(_SensorCenter.x, _LensY, _SensorCenter.z), _LensRadius, 11);
                }

                if (patchHit.didIntersect && patchHit.t < hit.t) hit = patchHit;

                if (hit.didIntersect && hit.materialID == 8) arrowPrimaryHits++;
            }

            if (hit.didIntersect) {
                if (hit.materialID == 4) {
                    float rawEmission = EvaluateEmission(hit.materialID, ray.wavelength) * throughput;
                    finalSpectralRadiance += min(rawEmission, _IntensityClamp);
                    break;
                }
                
                if (hit.materialID >= 5 && hit.materialID <= 7) {
                    float3 axisColor = (hit.materialID == 5) ? float3(5.0f, 0.1f, 0.1f) :
                                       (hit.materialID == 6) ? float3(0.1f, 5.0f, 0.1f) :
                                                               float3(0.1f, 0.1f, 5.0f);
                    
                    float3 sceneSampleRGB = max(axisColor * throughput, 0.0f);
                    accumulatedFrameRGB += sceneSampleRGB;
                    sampleHitSkyDirectly = false;
                    break;
                }

                if (hit.materialID == 8) {
                    float3 arrowColor = float3(5.0f, 4.0f, 0.1f); 
                    float3 sceneSampleRGB = max(arrowColor * throughput, 0.0f);
                    accumulatedFrameRGB += sceneSampleRGB;
                    sampleHitSkyDirectly = false;
                    break;
                }
                
                if (hit.materialID == 10) {
                    float3 sensorColor = _SensorColor.rgb;

                    float2 cells    = max(_SensorGridCells, float2(1.0f, 1.0f));
                    float2 gridUV   = (hit.position.xz - _SensorCenter.xz + _SensorHalfSize) / (2.0f * _SensorHalfSize); 
                    float2 gridPos  = gridUV * cells;                       

                    if (_ShowSensorImage > 0.5f) {
                        uint2 cellIdx = (uint2)clamp(floor(gridPos), float2(0.0f, 0.0f), cells - 1.0f);
                        sensorColor = SensorImage[cellIdx].rgb * _SensorExposure;
                    }

                    if (_SensorGridEnabled > 0.5f) {
                        float2 cellFrac = frac(gridPos);
                        float2 distToLine = min(cellFrac, 1.0f - cellFrac);     
                        bool onLine   = min(distToLine.x, distToLine.y) < _SensorLineWidth * 0.5f;
                        float2 distToEdge = min(gridPos, cells - gridPos);
                        bool onBorder = min(distToEdge.x, distToEdge.y) < _SensorBorderWidth * 0.5f;
                        if (onBorder)     sensorColor = _SensorBorderColor.rgb;
                        else if (onLine)  sensorColor = _SensorGridColor.rgb;
                    }
                    float3 sceneSampleRGB = max(sensorColor * throughput, 0.0f);
                    accumulatedFrameRGB += sceneSampleRGB;
                    sampleHitSkyDirectly = false;
                    break;
                }

                if (hit.materialID == 11) {
                    float rim = length(hit.position.xz - _SensorCenter.xz) / max(_LensRadius, 1e-4f);
                    float3 lensColor = (rim > 0.9f) ? float3(0.9f, 1.4f, 2.0f) : float3(0.15f, 0.35f, 0.6f);
                    accumulatedFrameRGB += max(lensColor * throughput, 0.0f);
                    sampleHitSkyDirectly = false;
                    break;
                }

                if (hit.materialID == 9) {
                    float3 sceneSampleRGB = PatchColor(hit.position, hit.normal) * throughput;
                    accumulatedFrameRGB += max(sceneSampleRGB, 0.0f);
                    sampleHitSkyDirectly = false;
                    break;
                }

                if (hit.materialID == 2) {
                    float3 targetDir = normalize(hit.normal + RandomInUnitSphere(rngState));
                    ray.direction = targetDir;
                    ray.origin = hit.position + hit.normal * 0.001f;
                    throughput *= 0.8f;
                    
                    if (NextRandom(rngState) > throughput) break;
                }
            } else {
                if (i == 0) sampleHitSkyDirectly = true;
                else finalSpectralRadiance += EvaluateSkyEmission(ray.wavelength, ray.direction) * throughput;
                break;
            }        
        }
        
        if (sampleHitSkyDirectly) {
            skyPixelsAccumulator += 1.0f;
        } else {
            float3 sceneSampleRGB = max(XYZToRGB(WavelengthToXYZ(ray.wavelength) * finalSpectralRadiance * (400.0f * 0.00535f)), 0.0f);
            sceneSampleRGB = min(sceneSampleRGB, float3(1e4f, 1e4f, 1e4f));
            accumulatedFrameRGB += sceneSampleRGB;
        }
    }

    float3 frameRGB = float3(0.0f, 0.0f, 0.0f);
    bool hitSkyDirectly = (skyPixelsAccumulator / (float)SAMPLES_PER_FRAME) > 0.5f;
    if (hitSkyDirectly) frameRGB = float3(0.0f, 0.0f, 0.0f);
    else frameRGB = accumulatedFrameRGB / (float)SAMPLES_PER_FRAME;

    float4 prevAccum = AccumulationBuffer[id.xy];
    float prevCount = min(prevAccum.w, (float)(_SampleIndex - 1));

    float newCount;
    float blendFactor;
    if (arrowPrimaryHits > 0) {
        blendFactor = 1.0f;       
        newCount = 0.0f;          
    } else {
        blendFactor = 1.0f / (prevCount + 1.0f);
        newCount = prevCount + 1.0f;
    }

    float3 accumulatedRGB = lerp(prevAccum.xyz, frameRGB, blendFactor);
    AccumulationBuffer[id.xy] = float4(accumulatedRGB, newCount);
    
    Result[id.xy] = float4(pow(accumulatedRGB / (accumulatedRGB + 1.0f), 1.0f / 2.2f), 1.0f);
}   